# The Play Store signing key and everything that carries it. Losing this
# key means never updating the listing again; LEAKING it means somebody
# else can ship an update as you. It lives in the owner's own backup, never
# in the repository.
signing.keystore
signing-key-info.txt
*.keystore
*.jks
*.aab
*.apk

# Python leaves these behind now that the build imports a sibling module.
__pycache__/
*.pyc
